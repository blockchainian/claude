#!/usr/bin/env -S uv run --quiet --script
# ABOUTME: One agent holds an entire claimed phone task; every Appium operation checks its owner.
# ABOUTME: Creates are reserved atomically and explicit deletes retain ownership until release.
"""WebDriverAgent replaces its previous session on a second create. A shared
per-device claim prevents duplicate creates across hosts and binds preparation,
connection and subsequent operations to one host session/agent for the whole task.
All device operations require explicit session IDs; discovery remains available.
"""

from __future__ import annotations

import json
import os
import re
import sys
from pathlib import Path

from claim_state import locked, read, write

CREATED = re.compile(r"created successfully with ID: (\S+)")
DELETED = re.compile(r"Session (\S+) deleted successfully")


def lock_dir() -> Path:
    return Path(os.environ.get("TMPDIR") or "/tmp")


def lock_path(udid: str) -> Path:
    return lock_dir() / f"ios-screenshot-lock.{udid}.json"


def deny(reason: str) -> None:
    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "PreToolUse",
        "permissionDecision": "deny",
        "permissionDecisionReason": reason,
    }}))


def udid_of(tool_input: dict) -> str | None:
    caps = tool_input.get("capabilities")
    if isinstance(caps, str):
        try:
            caps = json.loads(caps)
        except json.JSONDecodeError:
            return None
    if not isinstance(caps, dict):
        return None
    udid = caps.get("appium:udid") or caps.get("udid")
    return udid if isinstance(udid, str) and udid else None


def response_text(response) -> tuple[str, bool]:
    """The tool's text parts joined, and whether it reported an error."""
    if isinstance(response, str):
        return response, False
    if isinstance(response, list):
        parts = [response_text(part) for part in response]
        return "\n".join(text for text, _ in parts), any(error for _, error in parts)
    if isinstance(response, dict):
        if "content" in response:
            text, nested_error = response_text(response["content"])
        elif "text" in response:
            text = str(response["text"])
        else:
            text = json.dumps(response)
        return text, bool(response.get("isError")) or (nested_error if "content" in response else False)
    return json.dumps(response), False


def caller_identity(payload: dict) -> tuple[str, str | None] | None:
    caller = payload.get("session_id")
    agent = payload.get("agent_id")
    if not isinstance(caller, str) or not caller:
        return None
    if agent is not None and (not isinstance(agent, str) or not agent):
        return None
    return caller, agent


def call_identity(payload: dict) -> dict | None:
    caller = caller_identity(payload)
    call = payload.get("tool_use_id")
    if caller is None or not isinstance(call, str) or not call:
        return None
    identity = {"caller": caller[0], "call": call}
    if caller[1] is not None:
        identity["agent"] = caller[1]
    return identity


def owns(held: dict, payload: dict) -> bool:
    caller = caller_identity(payload)
    return caller is not None and caller == (held.get("sessionOwner"), held.get("sessionAgent"))


def bind_owner(held: dict, payload: dict) -> bool:
    """Bind once for the entire claim, including failed creates and reconnects."""
    caller = caller_identity(payload)
    if caller is None:
        deny("The host must supply a valid session_id and, for subagents, agent_id.")
        return False
    if held.get("sessionOwner"):
        if not owns(held, payload):
            deny("This phone belongs to another agent; wait for its task to release the claim.")
            return False
    else:
        held["sessionOwner"] = caller[0]
        if caller[1] is not None:
            held["sessionAgent"] = caller[1]
    return True


def before_prepare(payload: dict, tool_input: dict) -> None:
    udid = tool_input.get("udid")
    if not isinstance(udid, str) or not re.fullmatch(r"[A-Za-z0-9-]+", udid):
        deny("Pass the explicit device udid before preparing WebDriverAgent.")
        return
    path = lock_path(udid)
    with locked(path):
        held = read(path)
        if held is None:
            deny(f"{udid} is not claimed. Run claim-simulator.mjs before preparing the device.")
        elif bind_owner(held, payload):
            write(path, held)


def before_session_operation(payload: dict, tool_input: dict) -> None:
    target = tool_input.get("sessionId")
    if not isinstance(target, str) or not target:
        deny("Pass your explicit sessionId on every phone operation; the MCP active session is shared.")
        return
    for path in lock_dir().glob("ios-screenshot-lock.*.json"):
        with locked(path):
            held = read(path)
            if held and held.get("session") == target:
                if not owns(held, payload):
                    deny(f"Session {target} belongs to another agent; wait for its task to release the claim.")
                return
    deny(f"Session {target} has no device claim owned by this agent; create it through the claimed workflow.")

def before_create(payload: dict, tool_input: dict) -> None:
    udid = udid_of(tool_input)
    if not udid or not re.fullmatch(r"[A-Za-z0-9-]+", udid):
        deny("Pass the phone's explicit UDID as appium:udid in capabilities; "
             "discover-ios-setup.mjs prints it in suggestedCapabilities.")
        return
    identity = call_identity(payload)
    if identity is None:
        deny("The host must supply session_id and tool_use_id to reserve a phone session.")
        return
    path = lock_path(udid)
    with locked(path):
        held = read(path)
        if held is None:
            deny(f"{udid} is not claimed. Run claim-simulator.mjs {udid} --run <RUN_ID> first, "
                 "and hold the claim until the capture run is done.")
            return
        if held.get("session") or held.get("pending"):
            deny(f"{udid} already has an Appium session or create in progress under run "
                 f"{held['run']}. Wait; if its session idled out, delete that explicit "
                 "sessionId before creating again.")
            return
        if not bind_owner(held, payload):
            return
        held["pending"] = identity
        write(path, held)


def after_create(payload: dict, tool_input: dict, response) -> None:
    udid = udid_of(tool_input)
    identity = call_identity(payload)
    if not udid or not re.fullmatch(r"[A-Za-z0-9-]+", udid) or identity is None:
        return
    path = lock_path(udid)
    with locked(path):
        held = read(path)
        if held is None or held.get("pending") != identity:
            return
        text, is_error = response_text(response)
        if is_error:
            del held["pending"]
            write(path, held)
            return
        match = CREATED.search(text)
        if not match:
            # An unknown result might still have created a real session. Retain the
            # reservation instead of allowing another create to end it.
            print("Cannot confirm Appium create result; phone remains reserved. "
                  "Inspect appium_session_management action=list before recovery.", file=sys.stderr)
            return
        del held["pending"]
        held["session"] = match.group(1)
        held["sessionOwner"] = identity["caller"]
        if identity.get("agent"):
            held["sessionAgent"] = identity["agent"]
        write(path, held)


def after_delete(payload: dict, tool_input: dict, response) -> None:
    text, is_error = response_text(response)
    target = tool_input.get("sessionId")
    if is_error or not isinstance(target, str) or not target:
        return
    match = DELETED.search(text)
    if not match or match.group(1).rstrip(".") != target:
        return
    for path in lock_dir().glob("ios-screenshot-lock.*.json"):
        with locked(path):
            held = read(path)
            if not held or held.get("session") != target:
                continue
            if not owns(held, payload):
                continue
            del held["session"]
            write(path, held)


def main() -> int:
    try:
        payload = json.load(sys.stdin)
    except json.JSONDecodeError:
        print("Invalid phone-session hook payload", file=sys.stderr)
        return 2
    if not isinstance(payload, dict) or not isinstance(payload.get("tool_input"), dict):
        print("Invalid phone-session hook input", file=sys.stderr)
        return 2
    event = payload.get("hook_event_name")
    tool_input = payload.get("tool_input") or {}
    action = tool_input.get("action")
    tool = re.split(r"appium[-_]mcp__", payload.get("tool_name", ""))[-1]
    session_tool = tool == "appium_session_management"
    try:
        if event == "PreToolUse":
            if session_tool and action == "create":
                before_create(payload, tool_input)
            elif session_tool and action == "list":
                pass  # Discovery does not drive the device or change the active session.
            elif tool == "select_device":
                pass  # Creation still requires explicit capabilities and a claim.
            elif tool in ("appium_prepare_ios_real_device", "prepare_ios_simulator", "appium_prepare_ios_simulator"):
                before_prepare(payload, tool_input)
            elif session_tool and action == "detach":
                deny("Delete the explicit owned session before releasing the device; do not detach it.")
            else:
                before_session_operation(payload, tool_input)
        elif session_tool and event == "PostToolUse" and action == "create":
            after_create(payload, tool_input, payload.get("tool_response"))
        elif session_tool and event == "PostToolUseFailure" and action == "create":
            if not payload.get("is_interrupt"):
                after_create(payload, tool_input, {"isError": True})
        elif session_tool and event == "PostToolUse" and action == "delete":
            after_delete(payload, tool_input, payload.get("tool_response"))
    except (OSError, ValueError) as error:
        if event == "PreToolUse":
            deny(f"Cannot safely read or update the device claim: {error}")
        else:
            print(f"Cannot update the device claim: {error}", file=sys.stderr)
            return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
