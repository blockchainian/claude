{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_build-ios-apps_appium-mcp__appium_session_management",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/phone-session-gate",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__plugin_build-ios-apps_appium-mcp__appium_session_management",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/phone-session-gate",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
