+  /**
+   * Opens a blank page in this manager's context through CDP
+   * Target.createTarget({ background: true }), which leaves the browser window
+   * inactive, and returns it once the context reports it.
+   */
+  async openPageInBackground(): Promise<Page> {
+    const context = this.context;
+    if (!context) throw new Error('Browser not launched');
+    const browser = context.browser();
+    if (!browser) return context.newPage();
+    const targetInfo = (page: Page) => withCdpSession(page, async (session) => (await session.send('Target.getTargetInfo')).targetInfo);
+    const anyPage = context.pages()[0];
+    const browserContextId: string | undefined = anyPage ? (await targetInfo(anyPage)).browserContextId : undefined;
+
+    const opened: Page[] = [];
+    let wake = () => {};
+    const onPage = (page: Page) => { opened.push(page); wake(); };
+    context.on('page', onPage);
+    const session = await browser.newBrowserCDPSession();
+    try {
+      const { targetId } = await session.send('Target.createTarget', {
+        url: 'about:blank',
+        background: true,
+        ...(browserContextId ? { browserContextId } : {}),
+      });
+      const deadline = Date.now() + 10_000;
+      let checked = 0;
+      while (Date.now() < deadline) {
+        while (checked < opened.length) {
+          const page = opened[checked++];
+          if ((await targetInfo(page)).targetId === targetId) return page;
+        }
+        await new Promise<void>((resolve) => { wake = resolve; setTimeout(resolve, 100); });
+      }
+      throw new Error('Background tab did not open within 10s');
+    } finally {
+      context.off('page', onPage);
+      await session.detach().catch(() => {});
+    }
+  }
