+/**
+ * Where headed browse windows open: the display BROWSER_DISPLAY names (any part
+ * of its name, any case; empty means the main display), from the environment,
+ * else from ~/.config/web/.env. macOS only; on any failure Chromium places the
+ * window itself.
+ */
+
+import { execFileSync } from 'child_process';
+import * as fs from 'fs';
+import * as os from 'os';
+import * as path from 'path';
+
+const DISPLAY_ORIGIN_SCRIPT = path.resolve(__dirname, '..', 'scripts', 'displayOrigin.swift');
+
+export function browserDisplayName(
+  env: Record<string, string | undefined> = process.env,
+  envFile: string = path.join(os.homedir(), '.config', 'web', '.env'),
+): string {
+  if (env.BROWSER_DISPLAY !== undefined) return env.BROWSER_DISPLAY;
+  const lines = fs.existsSync(envFile) ? fs.readFileSync(envFile, 'utf-8').split('\n') : [];
+  const line = lines.find((l) => l.startsWith('BROWSER_DISPLAY='));
+  return line ? line.slice('BROWSER_DISPLAY='.length).trim().replace(/^"(.*)"$/, '$1') : '';
+}
+
+/** Chromium's --window-position for a point just inside the named display, or null when it is not connected. */
+export function windowPositionArg(displayName: string): string | null {
+  if (process.platform !== 'darwin') return null;
+  try {
+    const origin = execFileSync('swift', [DISPLAY_ORIGIN_SCRIPT, displayName], {
+      encoding: 'utf-8',
+      stdio: ['ignore', 'pipe', 'ignore'],
+      timeout: 60_000,
+    }).trim().match(/^(-?\d+) (-?\d+)$/);
+    return origin ? `--window-position=${Number(origin[1]) + 40},${Number(origin[2]) + 40}` : null;
+  } catch {
+    return null;
+  }
+}
