diff --git a/browse/test/browser-display.test.ts b/browse/test/browser-display.test.ts
new file mode 100644
index 000000000..b9e49af89
--- /dev/null
+++ b/browse/test/browser-display.test.ts
@@ -0,0 +1,32 @@
+/**
+ * Headed windows open on BROWSER_DISPLAY: the name comes from the environment,
+ * else ~/.config/web/.env, and becomes Chromium's --window-position.
+ */
+
+import { afterAll, expect, test } from 'bun:test';
+import * as fs from 'fs';
+import * as os from 'os';
+import * as path from 'path';
+import { browserDisplayName, windowPositionArg } from '../src/browser-display';
+
+const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'browse-display-'));
+const envFile = path.join(dir, '.env');
+fs.writeFileSync(envFile, 'OTHER=1\nBROWSER_DISPLAY="Built-in"\n');
+afterAll(() => fs.rmSync(dir, { recursive: true, force: true }));
+
+test('the environment wins over the env file', () => {
+  expect(browserDisplayName({ BROWSER_DISPLAY: 'SAMSUNG' }, envFile)).toBe('SAMSUNG');
+});
+
+test('the env file is read, quotes dropped', () => {
+  expect(browserDisplayName({}, envFile)).toBe('Built-in');
+});
+
+test('without either, the main display', () => {
+  expect(browserDisplayName({}, path.join(dir, 'missing'))).toBe('');
+});
+
+test.skipIf(process.platform !== 'darwin')('the main display gives a window position; an absent one gives none', () => {
+  expect(windowPositionArg('')).toMatch(/^--window-position=-?\d+,-?\d+$/);
+  expect(windowPositionArg('no display has this name')).toBeNull();
+}, 120_000);
