diff --git a/browse/test/no-tab-recovery.test.ts b/browse/test/no-tab-recovery.test.ts
new file mode 100644
index 000000000..67b597194
--- /dev/null
+++ b/browse/test/no-tab-recovery.test.ts
@@ -0,0 +1,67 @@
+/**
+ * The daemon must stay recoverable after its last tab closes.
+ *
+ * Closing every tab used to wedge the CLI completely: `handleCommandInternalImpl`
+ * (server.ts) and `handleMetaCommand` (meta-commands.ts) both resolved
+ * `getActiveSession()` above their dispatch, so every command threw
+ * `No active page. Use "browse goto <url>" first.` — including `restart`, `stop`
+ * and `newtab`, which exist to clear exactly that state, and including `goto`,
+ * the command the error text sends you to. There was no way back but SIGTERM.
+ *
+ * These pin the contract: a command that does not need a tab must not ask for one.
+ */
+
+import { describe, it, expect } from 'bun:test';
+import { BrowserManager } from '../src/browser-manager';
+import { handleMetaCommand } from '../src/meta-commands';
+
+const NO_ACTIVE_PAGE = 'No active page';
+
+/** A manager with no browser and no tabs — the state a closed last tab leaves. */
+const tabless = () => new BrowserManager();
+const noopShutdown = () => Promise.resolve();
+
+describe('meta commands with every tab closed', () => {
+  it('still restarts, which is the documented way out', async () => {
+    const result = await handleMetaCommand('restart', [], tabless(), noopShutdown);
+    expect(result).toBe('Restarting...');
+  });
+
+  it('still stops', async () => {
+    const result = await handleMetaCommand('stop', [], tabless(), noopShutdown);
+    expect(result).toBe('Server stopped');
+  });
+
+  it('still lists tabs, and lists none', async () => {
+    const result = await handleMetaCommand('tabs', [], tabless(), noopShutdown);
+    expect(result).toBe('');
+  });
+
+  /**
+   * Status is what you run to find out why nothing works, so it has to survive
+   * the state it is being used to diagnose. It used to refuse instead, which
+   * hid the one number that explains the wedge.
+   */
+  it('still reports status, naming the tab count that explains the wedge', async () => {
+    const result = await handleMetaCommand('status', [], tabless(), noopShutdown);
+    expect(result).toContain('Tabs: 0');
+    expect(result).not.toContain(NO_ACTIVE_PAGE);
+  });
+
+  /**
+   * `newtab` cannot succeed without a browser, but it must fail for the real
+   * reason. Reporting "No active page" for a command whose whole job is to
+   * create one is what made the wedge unescapable.
+   */
+  it('fails newtab on the browser being gone, not on the tab being gone', async () => {
+    await expect(handleMetaCommand('newtab', [], tabless(), noopShutdown)).rejects.toThrow(
+      'Browser not launched',
+    );
+  });
+});
+
+describe('the active session is resolved only when it is needed', () => {
+  it('is still refused for a command that genuinely needs a tab', () => {
+    expect(() => tabless().getActiveSession()).toThrow(NO_ACTIVE_PAGE);
+  });
+});
