+
+// ─── Tab-scoped views ───────────────────────────────────────
+//
+// Commands pinned to a tab (BROWSE_TAB / --tab-id) see only that tab's
+// entries, so parallel clients on separate tabs don't read each other's
+// logs. A tab-scoped clear records a cursor instead of emptying the shared
+// buffer: other tabs' entries and the unpinned global view stay intact.
+
+type TabScopedEntry = { tabId?: number; seq?: number };
+
+const tabCursors = new WeakMap<CircularBuffer<any>, Map<number, number>>();
+
+function cursorsFor(buffer: CircularBuffer<any>): Map<number, number> {
+  let cursors = tabCursors.get(buffer);
+  if (!cursors) {
+    cursors = new Map();
+    tabCursors.set(buffer, cursors);
+  }
+  return cursors;
+}
+
+/** Entries of one tab added since that tab's last tab-scoped clear. */
+export function tabEntries<T extends TabScopedEntry>(buffer: CircularBuffer<T>, tabId: number): T[] {
+  const from = cursorsFor(buffer).get(tabId) ?? 0;
+  return buffer.toArray().filter(e => e.tabId === tabId && (e.seq ?? 0) >= from);
+}
+
+/** Hides every entry of one tab added so far from tabEntries(). */
+export function clearTabEntries(buffer: CircularBuffer<TabScopedEntry>, tabId: number): void {
+  cursorsFor(buffer).set(tabId, buffer.totalAdded);
+}
