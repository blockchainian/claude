diff --git a/browse/test/tab-scoped-logs.test.ts b/browse/test/tab-scoped-logs.test.ts
new file mode 100644
index 00000000..43697bc5
--- /dev/null
+++ b/browse/test/tab-scoped-logs.test.ts
@@ -0,0 +1,107 @@
+/**
+ * Tab-scoped console/network logs — a command pinned to a tab (BROWSE_TAB /
+ * --tab-id) reads and clears only that tab's entries, so parallel clients
+ * driving separate tabs don't see each other's logs. Unpinned commands keep
+ * the global view.
+ */
+
+import { afterAll, beforeAll, describe, expect, test } from 'bun:test';
+import * as fs from 'fs';
+import * as os from 'os';
+import * as path from 'path';
+import { startTestServer } from './test-server';
+import { BrowserManager } from '../src/browser-manager';
+import { handleReadCommand } from '../src/read-commands';
+import { consoleBuffer, networkBuffer } from '../src/buffers';
+
+// Per-FILE Chromium profile (see test/commands.test.ts for the rationale).
+const ORIGINAL_CHROMIUM_PROFILE = process.env.CHROMIUM_PROFILE;
+let CHROMIUM_PROFILE_DIR: string | undefined;
+let testServer: ReturnType<typeof startTestServer>;
+let bm: BrowserManager;
+let baseUrl: string;
+let tabA: number;
+let tabB: number;
+
+const read = (tabId: number | undefined, command: string, args: string[] = []) =>
+  handleReadCommand(command, args, bm.getActiveSession(), bm, tabId === undefined ? undefined : { tabId });
+
+async function logAndFetch(tabId: number, label: string) {
+  const page = bm.getSession(tabId).getPage();
+  await page.goto(`${baseUrl}/basic.html?tab=${label}`);
+  await page.evaluate(async (l) => {
+    console.log(`log-from-${l}`);
+    await fetch(`/basic.html?fetch=${l}`);
+  }, label);
+}
+
+async function waitForStatus(fragment: string) {
+  for (let i = 0; i < 40; i++) {
+    const entry = networkBuffer.toArray().find(e => e.url.includes(fragment));
+    if (entry?.status) return;
+    await new Promise(resolve => setTimeout(resolve, 50));
+  }
+}
+
+beforeAll(async () => {
+  CHROMIUM_PROFILE_DIR = fs.mkdtempSync(path.join(os.tmpdir(), 'gstack-test-profile-'));
+  process.env.CHROMIUM_PROFILE = CHROMIUM_PROFILE_DIR;
+  testServer = startTestServer(0);
+  baseUrl = testServer.url;
+  bm = new BrowserManager();
+  await bm.launch();
+  tabA = bm.getActiveTabId();
+  tabB = await bm.newTab();
+  consoleBuffer.clear();
+  networkBuffer.clear();
+  await logAndFetch(tabA, 'a');
+  await logAndFetch(tabB, 'b');
+  await waitForStatus('fetch=a');
+  await waitForStatus('fetch=b');
+});
+
+afterAll(async () => {
+  try { testServer.server.stop(true); } catch {}
+  try { await Promise.race([bm?.close(), new Promise((resolve) => setTimeout(resolve, 3000))]); } catch {}
+  if (ORIGINAL_CHROMIUM_PROFILE === undefined) delete process.env.CHROMIUM_PROFILE;
+  else process.env.CHROMIUM_PROFILE = ORIGINAL_CHROMIUM_PROFILE;
+  if (CHROMIUM_PROFILE_DIR) { try { fs.rmSync(CHROMIUM_PROFILE_DIR, { recursive: true, force: true }); } catch {} }
+});
+
+describe('tab-scoped logs', () => {
+  test('pinned console shows only its own tab', async () => {
+    const a = await read(tabA, 'console');
+    expect(a).toContain('log-from-a');
+    expect(a).not.toContain('log-from-b');
+  });
+
+  test('pinned network shows only its own tab, with statuses', async () => {
+    const b = await read(tabB, 'network');
+    expect(b).toContain('fetch=b → 200');
+    expect(b).not.toContain('fetch=a');
+  });
+
+  test('unpinned reads still show every tab', async () => {
+    const all = await read(undefined, 'console');
+    expect(all).toContain('log-from-a');
+    expect(all).toContain('log-from-b');
+    const net = await read(undefined, 'network');
+    expect(net).toContain('fetch=a');
+    expect(net).toContain('fetch=b');
+  });
+
+  test('pinned --clear clears only its own tab', async () => {
+    await read(tabA, 'console', ['--clear']);
+    await read(tabA, 'network', ['--clear']);
+    expect(await read(tabA, 'console')).toBe('(no console messages)');
+    expect(await read(tabA, 'network')).toBe('(no network requests)');
+    expect(await read(tabB, 'console')).toContain('log-from-b');
+    expect(await read(tabB, 'network')).toContain('fetch=b');
+  });
+
+  test('pinned console --errors filters its own tab', async () => {
+    await bm.getSession(tabB).getPage().evaluate(() => console.error('error-from-b'));
+    expect(await read(tabA, 'console', ['--errors'])).toBe('(no console errors)');
+    expect(await read(tabB, 'console', ['--errors'])).toContain('error-from-b');
+  });
+});
