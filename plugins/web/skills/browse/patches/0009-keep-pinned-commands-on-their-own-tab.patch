diff --git a/browse/test/pinned-tab-context.test.ts b/browse/test/pinned-tab-context.test.ts
new file mode 100644
index 000000000..266338f69
--- /dev/null
+++ b/browse/test/pinned-tab-context.test.ts
@@ -0,0 +1,133 @@
+/** Commands pinned to a tab reject missing tabs and stay isolated across awaits. */
+import { afterAll, beforeAll, expect, test } from 'bun:test';
+import * as fs from 'fs';
+import * as os from 'os';
+import * as path from 'path';
+import { spawn, type ChildProcess } from 'node:child_process';
+
+const root = fs.mkdtempSync(path.join(os.tmpdir(), 'browse-pinned-context-'));
+const token = 'pinned-tab-context-test-token';
+let daemon: ChildProcess;
+let apiUrl: string;
+let pages: ReturnType<typeof Bun.serve>;
+let tabA: number;
+let tabB: number;
+let base: string;
+const gates = new Map<string, { entered: () => void; released: Promise<void> }>();
+
+function hold(name: string) {
+  let entered!: () => void;
+  let release!: () => void;
+  const arrived = new Promise<void>(resolve => { entered = resolve; });
+  const released = new Promise<void>(resolve => { release = resolve; });
+  gates.set(name, { entered, released });
+  return { arrived, release };
+}
+
+const command = (tabId: number | undefined, command: string, args: string[] = []) =>
+  fetch(`${apiUrl}/command`, {
+    method: 'POST',
+    headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
+    body: JSON.stringify({ tabId, command, args }),
+  });
+
+beforeAll(async () => {
+  const env = {
+    ...process.env, AUTH_TOKEN: token, BROWSE_PORT: '0',
+    BROWSE_STATE_FILE: path.join(root, 'state', 'browse.json'),
+    CHROMIUM_PROFILE: path.join(root, 'profile'), BROWSE_PARENT_PID: '0',
+    BROWSE_PERSIST_STATE: '0', BROWSE_TUNNEL: '0', BROWSE_TUNNEL_LOCAL_ONLY: '0',
+    BROWSE_HEADLESS_SKIP: '0',
+  };
+  delete env.BROWSE_HEADED;
+  delete env.BROWSE_EXTENSIONS_DIR;
+  daemon = spawn(process.execPath, [path.resolve(import.meta.dir, '../src/server.ts')], { env });
+  const log = fs.createWriteStream(path.join(root, 'daemon.log'));
+  daemon.stdout!.pipe(log);
+  daemon.stderr!.pipe(log);
+  await new Promise<void>((resolve, reject) => {
+    let output = '';
+    const timeout = setTimeout(() => reject(new Error('daemon startup timed out')), 20_000);
+    daemon.once('exit', code => { clearTimeout(timeout); reject(new Error(`daemon exited: ${code}`)); });
+    daemon.stdout!.on('data', chunk => {
+      output += chunk;
+      if (output.includes('[browse] Server running on ')) {
+        const state = JSON.parse(fs.readFileSync(env.BROWSE_STATE_FILE, 'utf8'));
+        apiUrl = `http://127.0.0.1:${state.port}`;
+        clearTimeout(timeout);
+        resolve();
+      }
+    });
+  });
+  pages = Bun.serve({
+    port: 0, hostname: '127.0.0.1',
+    async fetch(req) {
+      const gate = gates.get(new URL(req.url).pathname);
+      if (gate) { gate.entered(); await gate.released; }
+      return new Response('<p>page</p>', { headers: { 'Content-Type': 'text/html' } });
+    },
+  });
+  base = `http://127.0.0.1:${pages.port}`;
+  tabA = (await (await command(undefined, 'newtab', [`${base}/a`, '--json'])).json()).tabId;
+  tabB = (await (await command(undefined, 'newtab', [`${base}/b`, '--json'])).json()).tabId;
+}, 30_000);
+
+afterAll(async () => {
+  pages?.stop(true);
+  if (daemon && daemon.exitCode === null) {
+    daemon.kill('SIGINT');
+    await new Promise<void>(resolve => daemon.once('exit', () => resolve()));
+  }
+  fs.rmSync(root, { recursive: true, force: true });
+}, 15_000);
+
+test('missing pinned tab returns 404 without executing on any tab', async () => {
+  const response = await command(999999, 'js', ['window.wrongTabExecuted = true']);
+  const result = await response.json();
+  const executed = await Promise.all([tabA, tabB].map(id =>
+    command(id, 'js', ['window.wrongTabExecuted === true']).then(r => r.json())));
+  expect({ status: response.status, result, executed }).toEqual({
+    status: 404, result: { error: 'tab 999999 not found' }, executed: [false, false],
+  });
+});
+
+test('concurrent pinned commands keep their own tab across awaits', async () => {
+  const a = hold('/hold-a');
+  const b = hold('/hold-b');
+  const run = (tabId: number, name: string) => command(tabId, 'chain', [JSON.stringify([
+    ['js', `fetch('/hold-${name}').then(() => location.href)`],
+    ['js', 'location.href'],
+    ['console'],
+    ['network'],
+  ])]);
+  for (const [id, label] of [[tabA, 'a'], [tabB, 'b']] as const) {
+    await command(id, 'js', [`console.log('log-from-${label}')`]);
+  }
+  await command(undefined, 'tab', [String(tabA)]);
+  const pendingA = run(tabA, 'a');
+  let pendingB: Promise<Response> | undefined;
+  try {
+    await a.arrived;
+    pendingB = run(tabB, 'b');
+    await b.arrived;
+    a.release();
+    const responseA = await pendingA;
+    const outputA = await responseA.text();
+    b.release();
+    const responseB = await pendingB;
+    const outputB = await responseB.text();
+    expect(responseA.status).toBe(200);
+    expect(responseB.status).toBe(200);
+    for (const [output, own, other] of [[outputA, 'a', 'b'], [outputB, 'b', 'a']] as const) {
+      expect(output.match(new RegExp(`\\[js\\] ${base}/${own}`, 'g'))?.length).toBe(2);
+      expect(output).not.toContain(`${base}/${other}`);
+      expect(output).toContain(`log-from-${own}`);
+      expect(output).not.toContain(`log-from-${other}`);
+    }
+    expect(await (await command(undefined, 'js', ['location.href'])).text()).toBe(`${base}/a`);
+  } finally {
+    a.release();
+    b.release();
+    await Promise.all([pendingA, pendingB]);
+  }
+}, 15_000);
