diff --git a/browse/test/binary-version.test.ts b/browse/test/binary-version.test.ts
new file mode 100644
index 0000000..f6e4a7d
--- /dev/null
+++ b/browse/test/binary-version.test.ts
@@ -0,0 +1,54 @@
+/**
+ * Binary version handoff — the daemon runs under `bun run server.ts`, so its
+ * own execPath is bun and has no adjacent .version. The CLI passes its version
+ * to the spawned server, which records it as binaryVersion; without it the
+ * CLI's "binary updated, restarting server" check never fires.
+ */
+
+import { afterAll, describe, expect, test } from 'bun:test';
+import * as fs from 'fs';
+import * as os from 'os';
+import * as path from 'path';
+import { resolveBinaryVersion } from '../src/config';
+import { serverSpawnEnv } from '../src/cli';
+
+const distDir = fs.mkdtempSync(path.join(os.tmpdir(), 'browse-version-'));
+fs.writeFileSync(path.join(distDir, '.version'), 'build-123\n');
+const builtExec = path.join(distDir, 'browse');
+const bareExec = path.join(fs.mkdtempSync(path.join(os.tmpdir(), 'browse-bare-')), 'bun');
+
+afterAll(() => {
+  fs.rmSync(distDir, { recursive: true, force: true });
+  fs.rmSync(path.dirname(bareExec), { recursive: true, force: true });
+});
+
+describe('resolveBinaryVersion', () => {
+  test('prefers the version the CLI passed in BROWSE_BINARY_VERSION', () => {
+    expect(resolveBinaryVersion({ BROWSE_BINARY_VERSION: 'from-cli' }, builtExec)).toBe('from-cli');
+  });
+
+  test('falls back to the .version beside execPath', () => {
+    expect(resolveBinaryVersion({}, builtExec)).toBe('build-123');
+  });
+
+  test('is null when neither is available', () => {
+    expect(resolveBinaryVersion({}, bareExec)).toBeNull();
+  });
+});
+
+describe('serverSpawnEnv', () => {
+  test('passes the CLI binary version to the server', () => {
+    const env = serverSpawnEnv('42', undefined, builtExec);
+    expect(env.BROWSE_BINARY_VERSION).toBe('build-123');
+    expect(env.BROWSE_PARENT_PID).toBe('42');
+    expect(env.BROWSE_STATE_FILE).toBeTruthy();
+  });
+
+  test('omits the version when the CLI has none', () => {
+    expect('BROWSE_BINARY_VERSION' in serverSpawnEnv('42', undefined, bareExec)).toBe(false);
+  });
+
+  test('keeps the caller extraEnv on top', () => {
+    expect(serverSpawnEnv('42', { BROWSE_HEADED: '1' }, builtExec).BROWSE_HEADED).toBe('1');
+  });
+});
