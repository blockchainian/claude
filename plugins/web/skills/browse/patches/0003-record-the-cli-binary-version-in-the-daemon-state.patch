diff --git a/browse/src/cli.ts b/browse/src/cli.ts
index c5b8757..432f13e 100644
--- a/browse/src/cli.ts
+++ b/browse/src/cli.ts
@@ -494,6 +494,24 @@ function openDaemonLogSink(): number | 'ignore' {
   }
 }
 
+/**
+ * Environment the CLI adds for the server it spawns, including this binary's
+ * version so the daemon records it and a later binary update restarts it.
+ */
+export function serverSpawnEnv(
+  parentPid: string,
+  extraEnv?: Record<string, string>,
+  execPath: string = process.execPath,
+): Record<string, string> {
+  const binaryVersion = readVersionHash(execPath);
+  return {
+    BROWSE_STATE_FILE: config.stateFile,
+    BROWSE_PARENT_PID: parentPid,
+    ...(binaryVersion ? { BROWSE_BINARY_VERSION: binaryVersion } : {}),
+    ...(extraEnv || {}),
+  };
+}
+
