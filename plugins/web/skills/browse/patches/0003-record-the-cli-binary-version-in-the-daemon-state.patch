   }
 }
 
+/**
+ * The binary version the daemon records in its state file. The server runs
+ * under `bun run server.ts`, where execPath is bun and has no .version beside
+ * it, so the spawning CLI passes its own version in BROWSE_BINARY_VERSION.
+ */
+export function resolveBinaryVersion(
+  env: Record<string, string | undefined> = process.env,
+  execPath: string = process.execPath,
+): string | null {
+  return env.BROWSE_BINARY_VERSION || readVersionHash(execPath);
+}
