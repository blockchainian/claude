+/**
+ * Headed tabs open in the background: a CDP target created with
+ * { background: true } in the persistent (default) context, so Chromium does not
+ * take macOS focus. The opening is checked on a headless persistent context; the
+ * focus, screenshot and requestAnimationFrame checks need a visible window and run
+ * only with BROWSE_HEADED_TESTS=1.
+ */
+
+import { afterAll, beforeAll, describe, expect, test } from 'bun:test';
+import * as fs from 'fs';
+import * as os from 'os';
+import * as path from 'path';
+import { chromium, type BrowserContext } from 'playwright';
+import { BrowserManager, openPageInBackground } from '../src/browser-manager';
+
+describe('openPageInBackground', () => {
+  let profileDir: string;
+  let context: BrowserContext;
+
+  beforeAll(async () => {
+    profileDir = fs.mkdtempSync(path.join(os.tmpdir(), 'gstack-test-background-'));
+    context = await chromium.launchPersistentContext(profileDir, { headless: true });
+  });
+
+  afterAll(async () => {
+    await context.close().catch(() => {});
+    fs.rmSync(profileDir, { recursive: true, force: true });
+  });
+
+  test('each call opens its own page in the persistent context', async () => {
+    const pages = await Promise.all([openPageInBackground(context), openPageInBackground(context)]);
+    expect(new Set(pages).size).toBe(2);
+    for (const page of pages) expect(context.pages()).toContain(page);
+  });
+});
+
+describe.skipIf(!process.env.BROWSE_HEADED_TESTS)('headed newTab', () => {
+  const ORIGINAL_CHROMIUM_PROFILE = process.env.CHROMIUM_PROFILE;
+  const frontmostApp = () => Bun.spawnSync(['osascript', '-e', 'tell application "System Events" to name of first process whose frontmost is true']).stdout.toString().trim();
+  let profileDir: string;
+  let bm: BrowserManager;
+
+  beforeAll(async () => {
+    profileDir = fs.mkdtempSync(path.join(os.tmpdir(), 'gstack-test-background-headed-'));
+    process.env.CHROMIUM_PROFILE = profileDir;
+    bm = new BrowserManager();
+    await bm.launchHeaded();
+  }, 120_000);
+
+  afterAll(async () => {
+    try { await Promise.race([bm.close(), new Promise((resolve) => setTimeout(resolve, 3000))]); } catch {}
+    if (ORIGINAL_CHROMIUM_PROFILE === undefined) delete process.env.CHROMIUM_PROFILE;
+    else process.env.CHROMIUM_PROFILE = ORIGINAL_CHROMIUM_PROFILE;
+    fs.rmSync(profileDir, { recursive: true, force: true });
+  });
+
+  test('keeps the frontmost app, screenshots and runs requestAnimationFrame', async () => {
+    const before = frontmostApp();
+    const page = bm.getSession(await bm.newTab()).getPage();
+    await new Promise((resolve) => setTimeout(resolve, 1500));
+    expect(frontmostApp()).toBe(before);
+    await page.goto('data:text/html,<h1>background</h1>');
+    expect((await page.screenshot({ timeout: 10_000 })).length).toBeGreaterThan(0);
+    const frames = await page.evaluate(() => new Promise<number>((resolve) => {
+      let n = 0;
+      const start = performance.now();
+      const tick = () => { n++; if (performance.now() - start < 1000) requestAnimationFrame(tick); else resolve(n); };
+      requestAnimationFrame(tick);
+    }));
+    expect(frames).toBeGreaterThan(30);
+  }, 30_000);
+});
