+/**
+ * Opens a blank page through CDP Target.createTarget({ background: true }), which
+ * does not activate the browser window the way context.newPage() can. The target
+ * lands in the browser's default context, so context must be a persistent one.
+ */
+export async function openPageInBackground(context: BrowserContext): Promise<Page> {
+  const session = await context.browser()!.newBrowserCDPSession();
+  try {
+    let created: (targetId: string) => void = () => {};
+    const targetId = new Promise<string>((resolve) => { created = resolve; });
+    const page = context.waitForEvent('page', {
+      predicate: async (p) => (await withCdpSession(p, (s) => s.send('Target.getTargetInfo'))).targetInfo.targetId === await targetId,
+    });
+    created((await session.send('Target.createTarget', { url: 'about:blank', background: true })).targetId);
+    return await page;
+  } finally {
+    await session.detach().catch(() => {});
+  }
+}
+
