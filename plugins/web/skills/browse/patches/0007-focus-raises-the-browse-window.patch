diff --git a/browse/test/focus-window.test.ts b/browse/test/focus-window.test.ts
new file mode 100644
index 000000000..e9b9a36d6
--- /dev/null
+++ b/browse/test/focus-window.test.ts
@@ -0,0 +1,51 @@
+import { expect, test } from 'bun:test';
+import { BrowserManager } from '../src/browser-manager';
+import { handleMetaCommand } from '../src/meta-commands';
+import { chromium } from 'playwright';
+import { activateBrowserWindow, browserActivationScript } from '../src/focus-window';
+
+test('each backend resolves only its own Chromium PID, including persistent contexts', async () => {
+  const fs = await import('fs');
+  const os = await import('os');
+  const path = await import('path');
+  const profile = fs.mkdtempSync(path.join(os.tmpdir(), 'browse-focus-'));
+  const bm = new BrowserManager();
+  const persistent = await chromium.launchPersistentContext(profile, { headless: true });
+  try {
+    await bm.launch();
+    await expect(handleMetaCommand('focus', [], bm, () => {})).rejects.toThrow('headed mode');
+    const ownPid = await bm.getBrowserPid();
+    const session = await persistent.browser()!.newBrowserCDPSession();
+    const info = await session.send('SystemInfo.getProcessInfo');
+    const otherPid = info.processInfo.find(p => p.type === 'browser')!.id;
+    await session.detach();
+    expect(ownPid).toBeGreaterThan(0);
+    expect(ownPid).not.toBe(otherPid);
+    // Persistent contexts use the same browser-wide CDP endpoint as headed mode.
+    const persistentManager = new BrowserManager();
+    Object.assign(persistentManager, { context: persistent });
+    expect(await persistentManager.getBrowserPid()).toBe(otherPid);
+  } finally {
+    await bm.close();
+    await persistent.close();
+    fs.rmSync(profile, { recursive: true, force: true });
+  }
+}, 30_000);
+
+test('activation targets the supplied PID and verifies foreground status without browser names', () => {
+  expect(browserActivationScript).toContain('runningApplicationWithProcessIdentifier');
+  expect(browserActivationScript).toContain('Number(argv[0])');
+  expect(browserActivationScript).toContain('isActive');
+  expect(browserActivationScript).not.toMatch(/tell application|Google Chrome|Comet|Arc|Brave|Microsoft Edge/);
+});
+
+test('missing browser and invalid PID fail explicitly', async () => {
+  await expect(new BrowserManager().getBrowserPid()).rejects.toThrow('browser');
+  expect(() => activateBrowserWindow(0)).toThrow('PID');
+  expect(() => activateBrowserWindow(NaN)).toThrow('PID');
+});
+
+test.skipIf(process.platform !== 'darwin')('a nonexistent macOS process returns an activation error', () => {
+  // No app is activated and no browser window is opened.
+  expect(() => activateBrowserWindow(2147483647)).toThrow('No running browser process');
+});
