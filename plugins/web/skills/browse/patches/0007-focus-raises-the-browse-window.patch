@@ -0,0 +1,28 @@
+import { execFileSync } from 'child_process';
+
+/** AppKit activation by PID avoids launching or selecting another browser. */
+export const browserActivationScript = `
+ObjC.import('AppKit');
+function run(argv) {
+  const pid = Number(argv[0]);
+  const app = $.NSRunningApplication.runningApplicationWithProcessIdentifier(pid);
+  if (app.isNil()) throw new Error('No running browser process with PID ' + pid);
+  if (!app.activateWithOptions(3)) throw new Error('Cannot activate browser PID ' + pid);
+  for (let attempt = 0; attempt < 40; attempt++) {
+    if (app.isActive) return;
+    delay(0.05);
+  }
+  throw new Error('Browser PID ' + pid + ' did not become active');
+}`;
+
+export function activateBrowserWindow(pid: number): void {
+  if (!Number.isSafeInteger(pid) || pid <= 0) throw new Error('focus requires a valid browser PID');
+  if (process.platform !== 'darwin') throw new Error('focus is only supported on macOS');
+  try {
+    execFileSync('/usr/bin/osascript', ['-l', 'JavaScript', '-e', browserActivationScript, String(pid)], {
+      stdio: 'pipe', timeout: 5000,
+    });
+  } catch (error: any) {
+    throw new Error(`focus failed for browser PID ${pid}: ${error.message}`);
+  }
+}
