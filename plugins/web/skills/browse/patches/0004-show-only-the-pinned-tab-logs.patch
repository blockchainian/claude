+
+// Per-tab clears: a tab's entries added before buffer.totalAdded at its last clear stay hidden.
+const tabClears = new WeakMap<CircularBuffer<any>, Map<number, number>>();
+
+/** The tab's entries added since its last clearTabEntries(). */
+export function tabEntries<T extends { tabId?: number }>(buffer: CircularBuffer<T>, tabId: number): T[] {
+  const from = tabClears.get(buffer)?.get(tabId) ?? 0;
+  const firstSeq = buffer.totalAdded - buffer.length;
+  return buffer.toArray().filter((e, i) => e.tabId === tabId && firstSeq + i >= from);
+}
+
+export function clearTabEntries(buffer: CircularBuffer<any>, tabId: number): void {
+  if (!tabClears.has(buffer)) tabClears.set(buffer, new Map());
+  tabClears.get(buffer)!.set(tabId, buffer.totalAdded);
+}
