diff --git a/browse/test/tab-scoped-logs.test.ts b/browse/test/tab-scoped-logs.test.ts
new file mode 100644
index 000000000..93c1883eb
--- /dev/null
+++ b/browse/test/tab-scoped-logs.test.ts
@@ -0,0 +1,84 @@
+/**
+ * Commands pinned to a tab (BROWSE_TAB / --tab-id) read and clear only that
+ * tab's console and network entries.
+ */
+
+import { afterAll, beforeAll, expect, test } from 'bun:test';
+import * as fs from 'fs';
+import * as os from 'os';
+import * as path from 'path';
+import { BrowserManager } from '../src/browser-manager';
+import { handleReadCommand } from '../src/read-commands';
+
+const ORIGINAL_CHROMIUM_PROFILE = process.env.CHROMIUM_PROFILE;
+let profileDir: string;
+let server: ReturnType<typeof Bun.serve>;
+let bm: BrowserManager;
+let tabA: number;
+let tabB: number;
+
+const read = (tabId: number, command: string, args: string[] = []) =>
+  handleReadCommand(command, args, bm.getSession(tabId), bm, { tabId });
+
+beforeAll(async () => {
+  profileDir = fs.mkdtempSync(path.join(os.tmpdir(), 'gstack-test-tab-logs-'));
+  process.env.CHROMIUM_PROFILE = profileDir;
+  // /shared answers the first request only after the second arrives, so the
+  // two tabs' requests for the same URL are in flight together.
+  let releaseFirst = () => {};
+  const secondArrived = new Promise<void>((resolve) => { releaseFirst = resolve; });
+  let requests = 0;
+  server = Bun.serve({
+    port: 0,
+    hostname: '127.0.0.1',
+    async fetch(req) {
+      if (new URL(req.url).pathname !== '/shared') return new Response('<p>page</p>', { headers: { 'Content-Type': 'text/html' } });
+      if (++requests === 1) { await secondArrived; return new Response('first', { status: 201 }); }
+      releaseFirst();
+      await Bun.sleep(300);
+      return new Response('second', { status: 202 });
+    },
+  });
+  bm = new BrowserManager();
+  await bm.launch();
+  tabA = bm.getActiveTabId();
+  tabB = await bm.newTab();
+  for (const [tab, label] of [[tabA, 'a'], [tabB, 'b']] as const) {
+    const page = bm.getSession(tab).getPage();
+    await page.goto(`http://127.0.0.1:${server.port}/page`);
+    await page.evaluate((l) => console.log(`log-from-${l}`), label);
+  }
+  const first = bm.getSession(tabA).getPage().evaluate(() => fetch('/shared', { cache: 'no-store' }));
+  await Bun.sleep(200);
+  await Promise.all([first, bm.getSession(tabB).getPage().evaluate(() => fetch('/shared', { cache: 'no-store' }))]);
+}, 30_000);
+
+afterAll(async () => {
+  server?.stop(true);
+  try { await Promise.race([bm.close(), new Promise((resolve) => setTimeout(resolve, 3000))]); } catch {}
+  if (ORIGINAL_CHROMIUM_PROFILE === undefined) delete process.env.CHROMIUM_PROFILE;
+  else process.env.CHROMIUM_PROFILE = ORIGINAL_CHROMIUM_PROFILE;
+  fs.rmSync(profileDir, { recursive: true, force: true });
+});
+
+test('console shows only the pinned tab', async () => {
+  const a = await read(tabA, 'console');
+  expect(a).toContain('log-from-a');
+  expect(a).not.toContain('log-from-b');
+});
+
+test('network shows only the pinned tab, each request with its own status', async () => {
+  const a = await read(tabA, 'network');
+  const b = await read(tabB, 'network');
+  expect([a.includes('/shared → 201'), a.includes('/shared → 202')]).toEqual([true, false]);
+  expect([b.includes('/shared → 202'), b.includes('/shared → 201')]).toEqual([true, false]);
+});
+
+test('--clear clears only the pinned tab', async () => {
+  await read(tabA, 'console', ['--clear']);
+  await read(tabA, 'network', ['--clear']);
+  expect(await read(tabA, 'console')).toBe('(no console messages)');
+  expect(await read(tabA, 'network')).toBe('(no network requests)');
+  expect(await read(tabB, 'console')).toContain('log-from-b');
+  expect(await read(tabB, 'network')).toContain('/shared');
+});
