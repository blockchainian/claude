diff --git a/browse/test/profile-lock.test.ts b/browse/test/profile-lock.test.ts
new file mode 100644
index 000000000..a5a7b977b
--- /dev/null
+++ b/browse/test/profile-lock.test.ts
@@ -0,0 +1,95 @@
+import { expect, test } from 'bun:test';
+import * as fs from 'fs';
+import * as os from 'os';
+import * as path from 'path';
+import { cleanSingletonLocks } from '../src/config';
+
+const lockNames = ['SingletonLock', 'SingletonSocket', 'SingletonCookie'];
+function profile(target: string) {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'browse-lock-'));
+  const dir = path.join(root, 'chromium-profile');
+  fs.mkdirSync(dir);
+  fs.symlinkSync(target, path.join(dir, 'SingletonLock'));
+  fs.symlinkSync('/nonexistent/browse-test-socket', path.join(dir, 'SingletonSocket'));
+  fs.symlinkSync('test-cookie', path.join(dir, 'SingletonCookie'));
+  return { root, dir };
+}
+function assertLocks(dir: string, target: string) {
+  expect(fs.readlinkSync(path.join(dir, 'SingletonLock'))).toBe(target);
+  for (const name of lockNames) expect(fs.lstatSync(path.join(dir, name)).isSymbolicLink()).toBe(true);
+}
+
+test('a dead local process allows all three stale locks to be removed', async () => {
+  const child = Bun.spawn([process.execPath, '-e', 'process.exit(0)'], { stdout: 'ignore', stderr: 'ignore' });
+  await child.exited;
+  const { root, dir } = profile(`${os.hostname()}-${child.pid}`);
+  try {
+    cleanSingletonLocks(dir);
+    for (const name of lockNames) expect(() => fs.lstatSync(path.join(dir, name))).toThrow();
+  } finally { fs.rmSync(root, { recursive: true, force: true }); }
+});
+
+test('a live local owner preserves every lock and reports the profile, PID and next step', () => {
+  const target = `${os.hostname()}-${process.pid}`;
+  const { root, dir } = profile(target);
+  try {
+    expect(() => cleanSingletonLocks(dir)).toThrow(String(process.pid));
+    expect(() => cleanSingletonLocks(dir)).toThrow(dir);
+    expect(() => cleanSingletonLocks(dir)).toThrow('browse stop');
+    assertLocks(dir, target);
+  } finally { fs.rmSync(root, { recursive: true, force: true }); }
+});
+
+test('a lock from another host is preserved even when its PID is absent locally', () => {
+  const target = `another-host-${os.hostname()}-2147483647`;
+  const { root, dir } = profile(target);
+  try {
+    expect(() => cleanSingletonLocks(dir)).toThrow('another-host');
+    assertLocks(dir, target);
+  } finally { fs.rmSync(root, { recursive: true, force: true }); }
+});
+
+test('unknown lock formats and missing lock owners never authorize cleanup', () => {
+  const { root, dir } = profile('unrecognized');
+  try {
+    expect(() => cleanSingletonLocks(dir)).toThrow('SingletonLock');
+    assertLocks(dir, 'unrecognized');
+    fs.unlinkSync(path.join(dir, 'SingletonLock'));
+    cleanSingletonLocks(dir);
+    expect(fs.lstatSync(path.join(dir, 'SingletonSocket')).isSymbolicLink()).toBe(true);
+    expect(fs.lstatSync(path.join(dir, 'SingletonCookie')).isSymbolicLink()).toBe(true);
+  } finally { fs.rmSync(root, { recursive: true, force: true }); }
+});
+
+test('a headless CLI neither kills a profile owner nor removes its locks', async () => {
+  const owner = Bun.spawn([process.execPath, '-e', 'setInterval(()=>{},1000)'], { stdout: 'ignore', stderr: 'ignore' });
+  const target = `${os.hostname()}-${owner.pid}`;
+  const { root, dir } = profile(target);
+  const env = { ...process.env, GSTACK_HOME: path.join(root, 'home'), CHROMIUM_PROFILE: dir,
+    BROWSE_STATE_FILE: path.join(root, '.gstack', 'browse.json'), BROWSE_PARENT_PID: '0' };
+  delete env.BROWSE_HEADED;
+  delete env.BROWSE_HEADLESS_SKIP;
+  const cli = path.resolve(import.meta.dir, '../src/cli.ts');
+  async function run(command: string) {
+    const proc = Bun.spawn([process.execPath, 'run', cli, command], { cwd: root, env, stdout: 'pipe', stderr: 'pipe' });
+    const [stdout, stderr, status] = await Promise.all([new Response(proc.stdout).text(), new Response(proc.stderr).text(), proc.exited]);
+    return { stdout, stderr, status };
+  }
+  try {
+    const result = await run('status');
+    const logs = ['browse-daemon.log', 'browse-startup-error.log'].map(name => {
+      const file = path.join(root, '.gstack', name);
+      return fs.existsSync(file) ? fs.readFileSync(file, 'utf8') : '';
+    }).join('\n');
+    expect(result.status, result.stderr + logs).toBe(0);
+    const stopped = await run('stop');
+    expect(stopped.status, stopped.stderr).toBe(0);
+    expect(() => process.kill(owner.pid, 0)).not.toThrow();
+    assertLocks(dir, target);
+  } finally {
+    await run('stop');
+    if (owner.exitCode === null) owner.kill();
+    await owner.exited;
+    fs.rmSync(root, { recursive: true, force: true });
+  }
+}, 30_000);
