diff --git a/browse/test/headed-newtab.test.ts b/browse/test/headed-newtab.test.ts
new file mode 100644
index 000000000..9db4966cb
--- /dev/null
+++ b/browse/test/headed-newtab.test.ts
@@ -0,0 +1,44 @@
+/**
+ * Headed newTab registers its page once: the context's 'page' handler already
+ * tracks every page the context opens. Opens a visible window, so it runs only
+ * with BROWSE_HEADED_TESTS=1.
+ */
+
+import { afterAll, beforeAll, describe, expect, test } from 'bun:test';
+import * as fs from 'fs';
+import * as os from 'os';
+import * as path from 'path';
+import { startTestServer } from './test-server';
+import { BrowserManager } from '../src/browser-manager';
+import { networkBuffer } from '../src/buffers';
+
+describe.skipIf(!process.env.BROWSE_HEADED_TESTS)('headed newTab', () => {
+  const ORIGINAL_CHROMIUM_PROFILE = process.env.CHROMIUM_PROFILE;
+  let profileDir: string;
+  let testServer: ReturnType<typeof startTestServer>;
+  let bm: BrowserManager;
+
+  beforeAll(async () => {
+    profileDir = fs.mkdtempSync(path.join(os.tmpdir(), 'gstack-test-headed-'));
+    process.env.CHROMIUM_PROFILE = profileDir;
+    testServer = startTestServer(0);
+    bm = new BrowserManager();
+    await bm.launchHeaded();
+  }, 120_000);
+
+  afterAll(async () => {
+    try { testServer.server.stop(true); } catch {}
+    try { await Promise.race([bm.close(), new Promise((resolve) => setTimeout(resolve, 3000))]); } catch {}
+    if (ORIGINAL_CHROMIUM_PROFILE === undefined) delete process.env.CHROMIUM_PROFILE;
+    else process.env.CHROMIUM_PROFILE = ORIGINAL_CHROMIUM_PROFILE;
+    fs.rmSync(profileDir, { recursive: true, force: true });
+  });
+
+  test('adds one tab, which logs each request once', async () => {
+    const before = bm.getTabCount();
+    const id = await bm.newTab();
+    expect(bm.getTabCount()).toBe(before + 1);
+    await bm.getSession(id).getPage().goto(`${testServer.url}/basic.html?headed-newtab=1`);
+    expect(networkBuffer.toArray().filter((e) => e.url.includes('headed-newtab=1')).length).toBe(1);
+  });
+});
