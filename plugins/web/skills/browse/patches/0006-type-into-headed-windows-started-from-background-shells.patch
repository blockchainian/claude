diff --git a/browse/test/aqua-launch.test.ts b/browse/test/aqua-launch.test.ts
new file mode 100644
index 000000000..23aeaca70
--- /dev/null
+++ b/browse/test/aqua-launch.test.ts
@@ -0,0 +1,85 @@
+import { expect, test } from 'bun:test';
+import { execFileSync } from 'child_process';
+import * as fs from 'fs';
+import * as os from 'os';
+import * as path from 'path';
+import { needsAquaLaunch, createLaunchAgent, bootstrapLaunchAgent } from '../src/aqua-launch';
+
+test('only macOS headed daemons outside Aqua need a LaunchAgent', () => {
+  for (const platform of ['darwin', 'linux', 'win32']) {
+    for (const headed of [undefined, '0', '1']) {
+      for (const manager of ['Aqua', 'Background', 'System', ' Aqua\n']) {
+        expect(needsAquaLaunch(platform, { BROWSE_HEADED: headed }, manager))
+          .toBe(platform === 'darwin' && headed === '1' && manager.trim() !== 'Aqua');
+      }
+    }
+  }
+});
+
+test.skipIf(process.platform !== 'darwin')('plist preserves arguments, cwd, all defined env and daemon logs', () => {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'browse-plist-'));
+  try {
+    const env = {
+      BROWSE_HEADED: '1', BROWSE_STATE_FILE: path.join(root, 'browse.json'),
+      BROWSE_PARENT_PID: '0', BROWSE_BINARY_VERSION: 'version',
+      CHROMIUM_PROFILE: 'profile & < > " \'', BROWSER_DISPLAY: 'display',
+      PATH: '/bin:/custom path', HOME: root, OTHER: 'line one\nline two', OMIT: undefined,
+    };
+    const options = { stateFile: env.BROWSE_STATE_FILE, stateDir: root, cwd: root,
+      args: ['/path with spaces/bun', 'run', 'server & < > " \'.ts'], env,
+      logPath: path.join(root, 'browse-daemon.log') };
+    const job = createLaunchAgent(options);
+    fs.writeFileSync(job.plistPath, job.plist);
+    const plist = JSON.parse(execFileSync('/usr/bin/plutil', ['-convert', 'json', '-o', '-', job.plistPath], { encoding: 'utf8' }));
+    expect(plist.Label).toBe(job.label);
+    expect(createLaunchAgent(options).label).not.toBe(job.label);
+    expect(path.dirname(job.plistPath)).toBe(root);
+    expect(plist.ProgramArguments.slice(3)).toEqual(options.args);
+    expect(plist.WorkingDirectory).toBe(root);
+    expect(plist.EnvironmentVariables).toEqual(Object.fromEntries(Object.entries(env).filter(([, v]) => v !== undefined)));
+    expect(plist.LimitLoadToSessionType).toBe('Aqua');
+    expect(plist.RunAtLoad).toBe(true);
+    expect(plist.AbandonProcessGroup).toBe(true);
+    expect(plist.StandardOutPath).toBe(options.logPath);
+    expect(plist.StandardErrorPath).toBe(options.logPath);
+    expect(plist.KeepAlive).toBeUndefined();
+  } finally { fs.rmSync(root, { recursive: true, force: true }); }
+});
+
+test.skipIf(process.platform !== 'darwin')('real LaunchAgent enters Aqua and bootout leaves its daemon alive', async () => {
+  // No Chromium: this process only records its launch context and stays alive.
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'browse-aqua-'));
+  const resultPath = path.join(root, 'result.json');
+  const script = path.join(root, 'daemon.ts');
+  const logPath = path.join(root, 'browse-daemon.log');
+  fs.writeFileSync(logPath, 'previous daemon log\n');
+  fs.writeFileSync(script, `import {execFileSync} from 'child_process';
+    await Bun.write(process.argv[2], JSON.stringify({pid:process.pid, cwd:process.cwd(),
+      env:process.env.AQUA_TEST, shellLevel:process.env.SHLVL, arg:process.argv[3], manager:execFileSync('/bin/launchctl',['managername'],{encoding:'utf8'}).trim()}));
+    console.log('aqua stdout'); console.error('aqua stderr'); setInterval(()=>{},1000);`);
+  let cleanup: (() => void) | undefined;
+  let pid: number | undefined;
+  try {
+    cleanup = bootstrapLaunchAgent({ stateFile: path.join(root, 'browse.json'), stateDir: root,
+      cwd: root, args: [process.execPath, 'run', script, resultPath, 'literal $HOME & <value>'],
+      env: { ...process.env, AQUA_TEST: 'literal & <value>\nnext', SHLVL: '73' }, logPath });
+    const deadline = Date.now() + 10_000;
+    while ((!fs.existsSync(resultPath) || !fs.existsSync(logPath) || !fs.readFileSync(logPath, 'utf8').includes('aqua stderr')) && Date.now() < deadline) await Bun.sleep(50);
+    const result = JSON.parse(fs.readFileSync(resultPath, 'utf8'));
+    pid = result.pid;
+    expect(result).toEqual({pid, cwd: fs.realpathSync(root), env:'literal & <value>\nnext', shellLevel:'73', arg:'literal $HOME & <value>', manager:'Aqua'});
+    cleanup(); cleanup = undefined;
+    await Bun.sleep(200);
+    expect(() => process.kill(pid!, 0)).not.toThrow();
+    expect(fs.readFileSync(logPath, 'utf8')).toContain('previous daemon log');
+    expect(fs.readFileSync(logPath, 'utf8')).toContain('aqua stdout');
+    expect(fs.readFileSync(logPath, 'utf8')).toContain('aqua stderr');
+    expect(fs.readdirSync(root).filter(f => f.endsWith('.plist'))).toEqual([]);
+  } finally {
+    if (!pid && fs.existsSync(resultPath)) pid = JSON.parse(fs.readFileSync(resultPath, 'utf8')).pid;
+    try { cleanup?.(); } finally {
+      if (pid) process.kill(pid, 'SIGTERM');
+      fs.rmSync(root, { recursive: true, force: true });
+    }
+  }
+}, 15_000);
