+/** Start headed macOS daemons in the user's Aqua bootstrap session. */
+import { execFileSync } from 'child_process';
+import { createHash, randomUUID } from 'crypto';
+import * as fs from 'fs';
+import * as path from 'path';
+import { writeSecureFile } from './file-permissions';
+
+export function needsAquaLaunch(
+  platform: string, env: NodeJS.ProcessEnv, managerName: string,
+): boolean {
+  return platform === 'darwin' && env.BROWSE_HEADED === '1' && managerName.trim() !== 'Aqua';
+}
+
+interface LaunchOptions {
+  stateFile: string;
+  stateDir: string;
+  args: string[];
+  cwd: string;
+  env: NodeJS.ProcessEnv;
+  logPath: string;
+}
+
+function xml(value: string): string {
+  if (/[\x00-\x08\x0b\x0c\x0e-\x1f\ufffe\uffff]/.test(value)) {
+    throw new Error('LaunchAgent value contains an invalid XML character');
+  }
+  return value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;').replace(/'/g, '&apos;');
+}
+
+export function createLaunchAgent(options: LaunchOptions) {
+  const digest = createHash('sha256').update(path.resolve(options.stateFile)).digest('hex').slice(0, 16);
+  const label = `com.gstack.browse.${digest}.${randomUUID()}`;
+  // launchd owns the launcher, while its detached child owns the daemon.
+  // AbandonProcessGroup keeps that child alive when the job is booted out.
+  const launcher = `const {spawn}=require('child_process');` +
+    `spawn(process.argv[1],process.argv.slice(2),` +
+    `{detached:true,stdio:['ignore','inherit','inherit'],env:process.env}).unref();`;
+  const args = [options.args[0], '-e', launcher, ...options.args];
+  const string = (value: string) => `<string>${xml(value)}</string>`;
+  const env = Object.entries(options.env).filter((entry): entry is [string, string] => entry[1] !== undefined);
+  const plist = `<?xml version="1.0" encoding="UTF-8"?>
+<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
+<plist version="1.0"><dict>
+<key>Label</key>${string(label)}
+<key>ProgramArguments</key><array>${args.map(string).join('')}</array>
+<key>WorkingDirectory</key>${string(options.cwd)}
+<key>EnvironmentVariables</key><dict>${env.map(([key, value]) => `<key>${xml(key)}</key>${string(value)}`).join('')}</dict>
+<key>LimitLoadToSessionType</key><string>Aqua</string>
+<key>RunAtLoad</key><true/>
+<key>AbandonProcessGroup</key><true/>
+<key>StandardOutPath</key>${string(options.logPath)}
+<key>StandardErrorPath</key>${string(options.logPath)}
+</dict></plist>\n`;
+  return { label, plistPath: path.join(path.resolve(options.stateDir), `${label}.plist`), plist };
+}
+
+/** Returns the cleanup to run after the daemon's startup probe, including on timeout. */
+export function bootstrapLaunchAgent(options: LaunchOptions): () => void {
+  const job = createLaunchAgent(options);
+  const domain = `gui/${process.getuid!()}`;
+  writeSecureFile(job.plistPath, job.plist);
+  try {
+    execFileSync('/bin/launchctl', ['bootstrap', domain, job.plistPath], { stdio: 'pipe', timeout: 5000 });
+  } catch (error) {
+    fs.unlinkSync(job.plistPath);
+    throw error;
+  }
+  return () => {
+    execFileSync('/bin/launchctl', ['bootout', `${domain}/${job.label}`], { stdio: 'pipe', timeout: 5000 });
+    fs.unlinkSync(job.plistPath);
+  };
+}
