#!/usr/bin/env bash
# ABOUTME: Test stand-in for the codex CLI. Reads the workstream marker embedded in the prompt and
# ABOUTME: simulates pass / fail-once / hang / no-op / conflicting workstreams plus merge resolution.
set -u

HERE="$(cd "$(dirname "$0")" && pwd)"
. "$HERE/../stub-scenarios.sh"

DIR=.
PROMPT=""
OFILE=""
CFG=""
MODE=exec
NAME=""
args=("$@")
i=0
while [ $i -lt ${#args[@]} ]; do
  a="${args[$i]}"
  case "$a" in
    -C) i=$((i+1)); DIR="${args[$i]}" ;;
    -o) i=$((i+1)); OFILE="${args[$i]}" ;;
    -c) i=$((i+1)); CFG="$CFG ${args[$i]}" ;;
    -s|-m|-p) i=$((i+1)) ;;
    review) MODE=review ;;
    exec|--ephemeral|--skip-git-repo-check|--json|--uncommitted) ;;
    --base) i=$((i+1)) ;;
    *) PROMPT="$a" ;;
  esac
  i=$((i+1))
done

if [ "$MODE" = "review" ]; then
  scenario_bump REVIEW; scenario_log "REVIEW cfg=${CFG# }"
  # record whether the engine still holds the delivery lock while reviewing
  if [ -e "$(git -C "$DIR" rev-parse --absolute-git-dir 2>/dev/null)/codex-execute/deliver.lock" ]; then
    scenario_log "REVIEW-LOCK-HELD"
  else
    scenario_log "REVIEW-LOCK-FREE"
  fi
  # optionally push an unrelated commit to origin from a second clone, simulating a
  # sibling landing on the branch while this run is still reviewing
  if [ -n "${STUB_ADVANCE_ORIGIN_CLONE:-}" ]; then
    echo "sibling" > "$STUB_ADVANCE_ORIGIN_CLONE/sibling.txt"
    git -C "$STUB_ADVANCE_ORIGIN_CLONE" add sibling.txt
    git -C "$STUB_ADVANCE_ORIGIN_CLONE" commit -qm "sibling commit during review"
    git -C "$STUB_ADVANCE_ORIGIN_CLONE" push -q origin HEAD:main
  fi
  [ -n "$OFILE" ] && echo "stub review: no findings" > "$OFILE"
  echo "stub review done"
  exit 0
fi

run_stub_scenario || exit $?
echo "stub codex done"
exit 0
