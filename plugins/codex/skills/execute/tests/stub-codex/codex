#!/usr/bin/env bash
# ABOUTME: Test stand-in for the codex CLI. Reads the workstream marker embedded in the prompt and
# ABOUTME: simulates pass / fail-once / hang / no-op / conflicting workstreams plus merge resolution.
set -u

HERE="$(cd "$(dirname "$0")" && pwd)"
. "$HERE/../stub-scenarios.sh"

DIR=.
PROMPT=""
OFILE=""
CFG=""
MODE=exec
NAME=""
SANDBOX=""
SCHEMA=""
args=("$@")
i=0
while [ $i -lt ${#args[@]} ]; do
  a="${args[$i]}"
  case "$a" in
    -C) i=$((i+1)); DIR="${args[$i]}" ;;
    -o) i=$((i+1)); OFILE="${args[$i]}" ;;
    -c) i=$((i+1)); CFG="$CFG ${args[$i]}" ;;
    -s) i=$((i+1)); SANDBOX="${args[$i]}" ;;
    -m|-p) i=$((i+1)) ;;
    --output-schema) i=$((i+1)); SCHEMA="$(basename "${args[$i]}")" ;;
    review) MODE=review ;;
    exec|--ephemeral|--skip-git-repo-check|--json|--uncommitted) ;;
    --base) i=$((i+1)) ;;
    *) PROMPT="$a" ;;
  esac
  i=$((i+1))
done

if [ "${args[0]:-}" = "app-server" ] && [ "${args[1]:-}" = "daemon" ]; then
  case "${args[2]:-}" in
    start) pwd > "${STUB_DIR:?}/daemon-start-cwd"; exit 0 ;;
    version) echo '{"status":"running"}'; exit 0 ;;
    *) exit 1 ;;
  esac
fi

case "$PROMPT" in Review*) MODE=review ;; esac
if [ "$MODE" = "review" ]; then
  scenario_bump REVIEW; scenario_log "REVIEW cfg=${CFG# }"
  scenario_log "REVIEW sandbox=$SANDBOX schema=$SCHEMA"
  scenario_log "REVIEW prompt=$(printf '%s' "$PROMPT" | tr '\n' ' ')"
  sleep "${STUB_REVIEW_SLEEP:-0}"
  # record whether the engine still holds the delivery lock while reviewing
  if [ -e "$(git -C "$DIR" rev-parse --absolute-git-dir 2>/dev/null)/codex-execute/deliver.lock" ]; then
    scenario_log "REVIEW-LOCK-HELD"
  else
    scenario_log "REVIEW-LOCK-FREE"
  fi
  [ -n "$OFILE" ] && printf '{"findings":[]}' > "$OFILE"
  echo "stub review done"
  exit 0
fi

run_stub_scenario || exit $?
echo "stub codex done"
exit 0
