#!/usr/bin/env bash
# ABOUTME: Test stand-in for daemon-run.mjs that accepts its task-runner CLI contract.
# ABOUTME: Records the thread name and prompt, then applies the scenario's round action.
set -u

DIR=.
OFILE=""
NAME=""
TIMEOUT_S=""
PROMPT=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    -C) DIR="$2"; shift 2 ;;
    -o) OFILE="$2"; shift 2 ;;
    --name) NAME="$2"; shift 2 ;;
    --timeout) TIMEOUT_S="$2"; shift 2 ;;
    -s) shift 2 ;;
    *) PROMPT="$1"; shift ;;
  esac
done

echo "name=$NAME dir=$DIR timeout=$TIMEOUT_S" >> "${STUB_DIR:?}/invocations.log"
printf '%s\n' "$PROMPT" >> "$STUB_DIR/prompts.log"

ROUND="$(wc -l < "$STUB_DIR/invocations.log" | tr -d ' ')"
if [ -f "$STUB_DIR/round-action.sh" ]; then
  STUB_ROUND="$ROUND" sh "$STUB_DIR/round-action.sh"
fi

if [ -n "$OFILE" ]; then
  if [ -f "$STUB_DIR/last-message.txt" ]; then cat "$STUB_DIR/last-message.txt" > "$OFILE"; else : > "$OFILE"; fi
fi
exit 0
