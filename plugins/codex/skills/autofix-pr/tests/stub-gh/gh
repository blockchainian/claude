#!/usr/bin/env bash
# ABOUTME: Test stand-in for the gh CLI serving the pull request, commit, comment and
# ABOUTME: review-thread fixtures the autofix-pr driver reads, and recording every invocation.
set -u

echo "$*" >> "${STUB_DIR:?}/gh.log"

case "$*" in
  user) echo '{"login": "me"}' ;;
  *graphql*) cat "$STUB_DIR/threads.json" ;;
  *"/reviews"*) if [ -f "$STUB_DIR/reviews.json" ]; then cat "$STUB_DIR/reviews.json"; else echo "[]"; fi ;;
  *"/comments"*) cat "$STUB_DIR/comments.json" ;;
  *"/commits/"*) cat "$STUB_DIR/commit.json" ;;
  *"/pulls/"*) cat "$STUB_DIR/pr.json" ;;
  *) echo "stub gh: unexpected call: $*" >&2; exit 1 ;;
esac
