#!/usr/bin/env bash
# ABOUTME: Test stand-in for the gh CLI serving the pull request, commit, comment and
# ABOUTME: review-thread fixtures the autofix-pr driver reads, and recording every invocation.
set -u

echo "$*" >> "${STUB_DIR:?}/gh.log"

case "$*" in
  *"reactions("*)
    # The review-wait query: compose the GraphQL shape from the REST-shaped fixtures.
    for f in reviews comments reactions; do [ -f "$STUB_DIR/$f.json" ] || echo "[]" > "$STUB_DIR/$f.json"; done
    jq -n --slurpfile r "$STUB_DIR/reviews.json" --slurpfile c "$STUB_DIR/comments.json" --slurpfile x "$STUB_DIR/reactions.json" '
      {data: {repository: {pullRequest: {
        reviews: {nodes: ($r[0] | map({submittedAt: .submitted_at, author: {login: (.user.login // null)}, commit: {oid: (.commit_id // null)}}))},
        reviewThreads: {nodes: [{comments: {nodes: ($c[0] | map({createdAt: .created_at, author: {login: (.user.login // null)}}))}}]},
        reactions: {nodes: ($x[0] | map({createdAt: .created_at, content: (if .content == "+1" then "THUMBS_UP" else (.content | ascii_upcase) end), user: {login: (.user.login // null)}}))}
      }}}}' ;;
  "api user") echo '{"login": "me"}' ;;
  *graphql*) cat "$STUB_DIR/threads.json" ;;
  *"/reactions"*) if [ -f "$STUB_DIR/reactions.json" ]; then cat "$STUB_DIR/reactions.json"; else echo "[]"; fi ;;
  *"/reviews"*) if [ -f "$STUB_DIR/reviews.json" ]; then cat "$STUB_DIR/reviews.json"; else echo "[]"; fi ;;
  *"/comments"*) cat "$STUB_DIR/comments.json" ;;
  *"/commits/"*) cat "$STUB_DIR/commit.json" ;;
  *"/pulls/"*) cat "$STUB_DIR/pr.json" ;;
  *) echo "stub gh: unexpected call: $*" >&2; exit 1 ;;
esac
