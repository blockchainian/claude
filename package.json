{
  "name": "blockchainian-claude",
  "private": true,
  "description": "The blockchainian plugin marketplace for Claude Code: the feature, codex, grok, mobile, render, cloudflare, proxy, intel, and web plugins.",
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "test": "npm run test:grok && npm run test:codex && npm run test:feature && npm run test:proxy && npm run test:intel && npm run test:web",
    "test:grok": "node --test tests/commands.test.mjs tests/runtime.test.mjs",
    "test:codex": "node --test tests/codex-manager.test.mjs",
    "validate": "claude plugin validate --strict .",
    "test:feature": "plugins/feature/hooks/tests/run.sh && plugins/feature/skills/ship/tests/run.sh && plugins/feature/skills/ship/tests/workstream.test.sh && plugins/feature/skills/ship/tests/watch-ci.test.sh && plugins/feature/skills/retro/tests/run.sh",
    "test:proxy": "python3 plugins/proxy/skills/inspect-app-traffic/tests/test_capture.py && python3 plugins/proxy/skills/inspect-app-traffic/tests/test_wg_config.py",
    "test:intel": "python3 plugins/intel/skills/transcribe/tests/test_transcribe.py && python3 plugins/intel/skills/digest/tests/test_digest.py && plugins/intel/skills/translate/tests/test_translate.py && node --test plugins/intel/skills/find-domain-names/tests/test_check.mjs && node --test plugins/intel/skills/case-study/tests/*.mjs",
    "test:web": "uv run plugins/web/skills/heap-snapshot-leaks/tests/test_diff_heap_snapshots.py && uv run plugins/web/skills/check-web-design/tests/test_check_design.py"
  }
}
